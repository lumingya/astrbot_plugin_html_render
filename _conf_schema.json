                    "description": {
                        "type": "text",
                        "description": "用途说明",
                        "default": "记录当前角色状态",
                        "hint": "会暴露给 AI，用于说明何时以及如何填写此面板"
                    },
                    "panel_mode": {
                        "type": "string",
                        "description": "渲染模式",
                        "default": "stateful",
                        "hint": "状态面板会按 ID 去重并保留最近状态；行内子模板可重复使用，并在标签出现的位置原地插入",
                        "options": [
                            "stateful",
                            "inline"
                        ],
                        "enum": [
                            "stateful",
                            "inline"
                        ],
                        "labels": [
                            "状态面板",
                            "行内子模板（可重复）"
                        ]
                    },
                    "output_mode": {
                        "type": "string",
                        "description": "输出时机",
                        "default": "when_relevant",
