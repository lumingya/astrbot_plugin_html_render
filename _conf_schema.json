                    },
                    "name": {
                        "type": "string",
                        "description": "面板名称",
                        "default": "角色状态栏",
                        "hint": "用于配置页、日志和 AI 提示词中的易读名称"
                    },
                    "panel_id": {
                        "type": "string",
                        "description": "面板 ID",
                        "default": "character_status",
