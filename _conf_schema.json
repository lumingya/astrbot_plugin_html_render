        "hint": "检测到 HTML 标签时自动渲染为图片"
    },
    "inject_prompt": {
        "type": "bool",
        "description": "向 AI 注入渲染说明",
        "default": true,
        "hint": "在 LLM 请求时注入 HTML 渲染使用说明"
    },
    "sub_html_panels": {
        "type": "template_list",
        "description": "子 HTML 面板与行内模板",
        "hint": "可添加状态面板或行内子模板。行内子模板可在正文任意位置重复插入并混用；AI 只输出简短 JSON，插件负责套用预制 HTML。",
        "templates": {
            "default": {
                "name": "自定义子 HTML 面板",
                "hint": "定义一个可单独启停的结构化状态面板",
