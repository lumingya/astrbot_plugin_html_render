                        "options": [
                            "always",
                            "when_relevant",
                            "on_change"
                        ],
                        "enum": [
                            "always",
                            "when_relevant",
                            "on_change"
                        ],
                        "labels": [
                            "每次回复",
                            "模型按需（推荐）",
                            "状态变化时"
                        ]
                    },
                    "fields": {
                        "type": "list",
                        "description": "字段规范",
                        "default": [
                            "name|名称|text|当前名称",
                            "progress|进度|percent|0 到 100 的数值"
                        ],
                        "hint": "格式：字段键|显示名|类型|说明|选项。类型支持 text、number、percent、boolean、choice、color、image；image 从 avatars 文件夹安全读取"
